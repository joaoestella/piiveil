{
  "name": "sigilo",
  "version": "0.1.0",
  "description": "Pseudonimização reversível de dados pessoais para o Claude Code, com foco em documentos brasileiros e na LGPD",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "João Vítor Estella",
  "repository": {
    "type": "git",
    "url": "https://github.com/joaoestella/sigilo"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"build/tests/**/*.test.js\"",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/sigilo.mjs --legal-comments=none"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
